<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:id="@+id/mapContainer"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_margin="12dp"
        app:cardCornerRadius="24dp" app:cardElevation="6dp">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/layerToggle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true"
            app:checkedButton="@id/btnRain">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRain" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rain" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClouds" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clouds" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTemp" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWind" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
